# Strategy Street Environment Configuration

# Database (TimescaleDB / PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=strategystreet
POSTGRES_PORT=5432
# For local host access:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/strategystreet?sslmode=disable
# For container-to-container access within Docker Compose:
# DATABASE_URL=postgres://postgres:postgres@timescaledb:5432/strategystreet?sslmode=disable

# Redis 7
# For local host access:
REDIS_URL=redis://localhost:6379/0
# For container-to-container access within Docker Compose:
# REDIS_URL=redis://redis:6379/0

# API Service (Go)
API_ADDR=0.0.0.0:8080
LOG_LEVEL=info
ENV=local

# Migration path
MIGRATIONS_PATH=./db/migrations
